<?xml version="1.0" encoding="utf-8" ?>
<configuration>

	<startup>
		<supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7.2" />
	</startup>

	<appSettings>
		<add key="ForecastDeviationPct" value="20"/>
		<add key="OutOfBandPct" value="15"/>
		<add key="RiseWindowDays" value="3"/>
		<add key="RiseThresholdMWh" value="100"/>
	</appSettings>

	<system.serviceModel>
		<bindings>
			<netTcpBinding>
				<binding name="TcpLargeBinding"
						 transferMode="Streamed"
						 maxReceivedMessageSize="10485760"
						 maxBufferSize="10485760" />
			</netTcpBinding>
		</bindings>
	</system.serviceModel>

</configuration>